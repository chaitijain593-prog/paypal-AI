# PayPal Sandbox Credentials
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Webhook
PAYPAL_WEBHOOK_ID=your_webhook_id_here
ALLOW_UNSIGNED_WEBHOOKS=false

# AI Provider
GEMINI_API_KEY=paste_your_copied_gemini_key_here
AI_MODEL=gemini-2.5-flash

# App Settings
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0

# Security & Financial Caps
HIGH_VALUE_AMOUNT_CAP=500.00
API_TOKENS=tok_admin_001:AdminOperator:ADMIN,tok_risk_001:SeniorRiskOfficer:SENIOR_RISK_OFFICER,tok_op_001:DisputeHandler:OPERATOR

# Signing Key Directory
SIGNING_KEY_DIR=keys

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
